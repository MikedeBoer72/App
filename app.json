{
  "expo": {
    "name": "YourLevel",
    "slug": "yourlevel",
    "scheme": "yourlevel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A0A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourlevel.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#4A90E2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
