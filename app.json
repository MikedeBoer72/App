{
  "expo": {
    "name": "YourLevel",
    "slug": "yourlevel",
    "scheme": "yourlevel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#0A012F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.yourlevel.app",
      "usesAppleSignIn": true,
      "appleTeamId": "MH6W95XU8T",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.yourlevel.app"]
      },
      "infoPlist": {
        "UIBackgroundModes": ["fetch"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Allow YourLevel to save your progress share cards to your photos."
      }
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "color": "#4A90E2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow YourLevel to access your photos to set your profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
